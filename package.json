{
  "name": "activityroster",
  "version": "0.1.0",
  "private": true,
  "description": "Compliance-aware staff rostering and course administration for RYA sailing/watersports centres. Multi-tenant SaaS.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run tests/isolation",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply activityroster --local",
    "db:migrate:remote": "wrangler d1 migrations apply activityroster --remote",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@opennextjs/cloudflare": "^1.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.8.1",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.125.0"
  }
}
