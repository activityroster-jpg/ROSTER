# Copy to `.dev.vars` (gitignored) for local dev, or use these keys with
# `wrangler secret put <NAME>` for production. See scripts/setup-secrets.sh.

# --- Auth (self-generated) ---------------------------------------------------
# Generate a strong value: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The auth base URL. Local: http://localhost:8787 · Prod: https://<apex>
BETTER_AUTH_URL=

# --- Non-secret vars (also in wrangler.toml [vars] for prod) -----------------
APP_APEX_DOMAIN=activityroster.com
APP_ENV=production

# --- Stripe (from your Stripe account — cannot be generated) -----------------
# Use a RESTRICTED key with only the scopes Checkout/Billing/Portal need.
STRIPE_SECRET_KEY=sk_live_or_test_...
# From the webhook endpoint you create for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for each plan (Products → Prices in Stripe).
# Optional price-id overrides. Leave blank: prices are found on your Stripe
# account by product name ("Small Club Plan", "Standard Plan", "Custom Package",
# "UK Onsite Daily Consultancy") and billing interval.
STRIPE_PRICE_SMALL_MONTHLY=
STRIPE_PRICE_SMALL_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_ONSITE=
# One-TIME price for the done-for-you setup service (a one-off, NOT recurring).
STRIPE_PRICE_SETUP=price_...

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_...

# --- Errors (Sentry, optional) -----------------------------------------------
SENTRY_DSN=https://...ingest.sentry.io/...

# --- Dev Center ---------------------------------------------------------------
# Comma-separated emails allowed into /admin. Unset = nobody.
PLATFORM_ADMIN_EMAILS=you@example.com

# --- Push notifications (Firebase service account JSON, one line) -------------
FCM_SERVICE_ACCOUNT_JSON=

# --- Integration API keys at rest (optional) ---------------------------------
# Dedicated AES key for booking-system tokens. Leave blank to derive one from
# BETTER_AUTH_SECRET. Generate: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# --- Universal / app links (optional; see mobile/README.md §4) ----------------
# Served at /.well-known/apple-app-site-association and /.well-known/assetlinks.json
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.activityroster.app
ANDROID_PACKAGE=com.activityroster.app
# Comma-separated SHA-256 signing-certificate fingerprints (AA:BB:...)
ANDROID_SHA256_FINGERPRINTS=

# --- Text-message second step (Twilio, optional) ------------------------------
# Leave blank and the "code by text" option simply isn't offered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number (+44…) or a Messaging Service SID (MG…)
TWILIO_FROM=
